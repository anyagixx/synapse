  <KnownIssues>
    <Issue id="KI-001" component="fastembed/ort" version="5.13.4/2.0.0-rc.12">
      <Description>First embedding use can download ONNX assets; macOS Intel requires dynamic ONNX Runtime loading.</Description>
      <Workaround>Embeddings are disabled by default. Enable with syn config set embedding.enabled true; on macOS Intel set ORT_DYLIB_PATH first. Search falls back to lexical on provider failure.</Workaround>
    </Issue>
    <Issue id="KI-002" component="fastembed/tokenizers/paste" version="5.13.4/0.22.2/1.0.15">
      <Description>cargo audit reports RUSTSEC-2024-0436 because tokenizers pulls paste through fastembed 5.13.4.</Description>
      <Workaround>CI waives RUSTSEC-2024-0436 until fastembed removes paste or Synapse replaces the embedding provider.</Workaround>
    </Issue>
    <Issue id="KI-003" component="ort/x86_64-apple-darwin" version="2.0.0-rc.12">
      <Description>ort does not publish a prebuilt ONNX Runtime binary for hosted x86_64-apple-darwin.</Description>
      <Workaround>v2.6.7 uses fastembed ort-load-dynamic; optional Intel macOS embeddings require ORT_DYLIB_PATH.</Workaround>
    </Issue>
  </KnownIssues>
